<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 480" width="400" height="480">
  <defs>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-opacity="0.35"/>
    </filter>
  </defs>
  <!-- 10 Golden Stars on top (Decacampeão Mineiro) -->
  <g fill="#f1c40f" stroke="#b7950b" stroke-width="0.8">
    <!-- Center Top Star (Bigger) -->
    <polygon points="200,8 205,24 222,24 208,34 213,50 200,40 187,50 192,34 178,24 195,24" />
    <polygon points="165,16 169,28 182,28 171,36 175,48 165,40 155,48 159,36 148,28 161,28" />
    <polygon points="235,16 239,28 252,28 241,36 245,48 235,40 225,48 229,36 218,28 231,28" />
    <polygon points="132,26 136,37 148,37 138,44 142,55 132,48 122,55 126,44 116,37 128,37" />
    <polygon points="268,26 272,37 284,37 274,44 278,55 268,48 258,55 262,44 252,37 264,37" />
    <polygon points="102,38 105,48 116,48 107,54 110,64 102,58 94,64 97,54 88,48 99,48" />
    <polygon points="298,38 301,48 312,48 303,54 306,64 298,58 290,64 293,54 284,48 295,48" />
    <polygon points="74,52 77,61 87,61 79,66 82,75 74,70 66,75 69,66 61,61 71,61" />
    <polygon points="326,52 329,61 339,61 331,66 334,75 326,70 318,75 321,66 313,61 323,61" />
    <polygon points="48,68 51,76 60,76 53,81 55,89 48,84 41,89 43,81 36,76 45,76" />
  </g>
  <!-- Outer Shield Border -->
  <path d="M40,100 C40,90 200,75 200,75 C200,75 360,90 360,100 C360,260 330,370 200,465 C70,370 40,260 40,100 Z" fill="#ffffff" filter="url(#shadow)" stroke="#0e5628" stroke-width="3"/>
  <!-- Green Shield Body -->
  <path d="M50,108 C50,100 200,87 200,87 C200,87 350,100 350,108 C350,252 322,355 200,448 C78,355 50,252 50,108 Z" fill="#006437"/>
  <!-- Inner White Border Accent -->
  <path d="M60,118 C60,112 200,101 200,101 C200,101 340,112 340,118 C340,245 315,342 200,432 C85,342 60,245 60,118 Z" fill="none" stroke="#ffffff" stroke-width="4"/>
  <!-- Centered America Decagram / Star & Monogram -->
  <circle cx="200" cy="245" r="95" fill="#00522c" stroke="#ffffff" stroke-width="5"/>
  <circle cx="200" cy="245" r="85" fill="#006437"/>
  <!-- Stylized AFC Monogram -->
  <g fill="#ffffff" font-family="'Arial Black', Impact, sans-serif" font-weight="900" text-anchor="middle">
    <!-- Big 'A' in center -->
    <text x="200" y="278" font-size="105" letter-spacing="-2">A</text>
    <!-- Crossbar and details -->
    <path d="M165,225 L235,225 L200,145 Z" fill="#006437"/>
    <text x="156" y="295" font-size="42" font-weight="900">F</text>
    <text x="244" y="295" font-size="42" font-weight="900">C</text>
  </g>
  <!-- Year 1912 banner at bottom of crest -->
  <rect x="145" y="360" width="110" height="26" rx="13" fill="#ffffff"/>
  <text x="200" y="378" font-family="'Arial Black', sans-serif" font-size="16" font-weight="900" fill="#006437" text-anchor="middle">1912</text>
</svg>
